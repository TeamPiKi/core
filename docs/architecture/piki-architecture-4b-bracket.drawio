        <mxCell id="code" value="sorted  = items.sortedBy { price }&lt;br/&gt;random  = Random(seed)&lt;br/&gt;byes    = sorted.pickRandom(byeCount)&lt;br/&gt;pairs   = (sorted - byes).chunked(2)&lt;br/&gt;ordered = pairs.shuffled(random)" style="rounded=1;arcSize=8;fillColor=#0F172A;strokeColor=none;fontColor=#E2E8F0;fontSize=11;align=left;verticalAlign=middle;html=1;spacingLeft=14;fontFamily=Courier New;" vertex="1" parent="1">
