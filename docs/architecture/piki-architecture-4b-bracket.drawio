          <mxGeometry x="24" y="46" width="432" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="아니면 target = 2^floor(log2(n))&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;→  매치 n - target,  부전승 2·target - n" style="rounded=1;arcSize=8;fillColor=#0F172A;strokeColor=none;fontColor=#E2E8F0;fontSize=11;align=left;verticalAlign=middle;html=1;spacingLeft=14;fontFamily=Courier New;" vertex="1" parent="grp-count">
