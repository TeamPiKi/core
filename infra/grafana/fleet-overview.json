{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki"
    }
  ],
  "__requires": [],
  "uid": "piki-fleet-overview",
  "title": "PiKi - 플릿 개요 (전 서비스·박스)",
  "tags": [
    "piki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": true,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "label": "환경",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROM}"
        },
        "definition": "label_values(environment)",
        "query": {
          "qryType": 1,
          "query": "label_values(environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "prod",
          "value": "prod",
          "selected": true
        },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false,
        "hide": 0
      },
      {
        "name": "service",
        "type": "custom",
        "label": "서비스",
        "query": "piki-core, piki-extractor, piki-renderer",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "piki-core",
            "value": "piki-core",
            "selected": false
          },
          {
            "text": "piki-extractor",
            "value": "piki-extractor",
            "selected": false
          },
          {
            "text": "piki-renderer",
            "value": "piki-renderer",
            "selected": false
          }
        ],
        "includeAll": true,
        "allValue": "piki-.+",
        "multi": true,
        "skipUrlSync": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "서비스 상태 (up)",
      "description": "label opt-in 수집 대상 서비스별 생존. 스크레이프 실패(앱 다운·포트 불통)면 DOWN.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "up{environment=\"$environment\", job=~\"$service\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "가동시간 (마지막 재시작 후)",
      "description": "배포·재시작 확인용. 버전 메트릭은 아직 없어(빌드 정보 미노출) 재시작 시각으로 대신 본다.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "process_uptime_seconds{environment=\"$environment\", job=~\"$service\"}",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "time() - process_start_time_seconds{environment=\"$environment\", job=\"piki-renderer\", job=~\"$service\"}",
          "legendFormat": "piki-renderer"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 요청률 (서비스별)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{environment=\"$environment\", application=~\"$service\", status=~\"5..\"}[5m]))",
          "legendFormat": "{{application}}"
        }
      ],
      "description": "core·extractor(Spring)만 — renderer 는 요청 카운터 미노출(#778 갭)."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ERROR 로그 수 (5분 창)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (service) (count_over_time({environment=\"$environment\", service=~\"$service\", level=~\"(?i)error\"} [5m]))",
          "legendFormat": "{{service}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (service) (count_over_time({environment=\"$environment\", service=~\"$service\", service=\"piki-renderer\"} |~ `(?i)error` !~ `error=None` [5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "description": "level 라벨(ECS 구조화) 기준. extractor 는 구조화 배선 전까지 여기 안 잡힌다(#778 갭). renderer 는 라인 필터."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "박스 메모리 사용률",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{environment=\"$environment\", box=~\".+\"} / node_memory_MemTotal_bytes{environment=\"$environment\", box=~\".+\"})",
          "legendFormat": "{{box}}"
        }
      ],
      "description": "작은 박스라 메모리가 1순위 리스크. box 라벨 = 박스 식별(피키 3박스)."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "박스 swap 사용",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "node_memory_SwapTotal_bytes{environment=\"$environment\", box=~\".+\"} - node_memory_SwapFree_bytes{environment=\"$environment\", box=~\".+\"}",
          "legendFormat": "{{box}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "박스 루트 디스크 여유",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "node_filesystem_avail_bytes{environment=\"$environment\", box=~\".+\", mountpoint=\"/\"}",
          "legendFormat": "{{box}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "통합 로그 (선택 서비스 전체)",
      "description": "line_format 으로 각 줄 앞에 [서비스] 를 붙인다. level 색상은 ECS 구조화 서비스에서 동작.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{environment=\"$environment\", service=~\"$service\"} | line_format \"[{{.service}}] {{ __line__ }}\""
        }
      ]
    }
  ]
}
