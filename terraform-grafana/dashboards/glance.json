    {
      "id": 9,
      "type": "timeseries",
      "title": "core 5xx 요청률 (환경별)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (environment) (rate(http_server_requests_seconds_count{application=\"piki-core\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{environment}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "ERROR 로그 수 (서비스별)",
