    {
      "id": 18,
      "type": "timeseries",
      "title": "renderer 동시 렌더 포화율",
      "description": "100% 면 새 렌더가 슬롯을 기다리다 실패한다.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
