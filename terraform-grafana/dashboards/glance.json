      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "time() - piki_db_backup_last_success_timestamp_seconds"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "아프나",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "core 5xx 요청률 (환경별)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (environment) (rate(http_server_requests_seconds_count{application=\"piki-core\", status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{environment}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "ERROR 로그 수 (서비스별)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (service) (count_over_time({service=~\"piki-core|piki-extractor|piki-renderer\", level=~\"(?i)(error|critical)\"}[$__interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "파싱 실패 (core, 환경별)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "sum by (environment) (count_over_time({container=~\"piki-core-(blue|green)\"} |= \"item.parse.result\" | logfmt | __error__=\"\" | result=\"failed\" [$__interval]))",
          "legendFormat": "{{environment}}"
        }
      ],
      "interval": "1m",
      "description": "로그 기반 - 메트릭 카운터는 재배포 리셋·신규 시계열 첫 증가 누락으로 단발 실패를 놓친다 (2026-08-30 실측)"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "추출 계층 실패 신호",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum(increase(product_extract_escalation_total{outcome=\"failed\"}[$__rate_interval]))",
          "legendFormat": "extractor escalation 실패"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (verdict) (increase(piki_renderer_renders_total{verdict!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "renderer {{verdict}}"
        }
      ],
      "interval": "1m"
    },
    {
      "id": 13,
      "type": "row",
      "title": "박스",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "메모리 사용률 (박스별)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{box=~\".+\"} / node_memory_MemTotal_bytes{box=~\".+\"})",
          "legendFormat": "{{box}} ({{environment}})"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "루트 디스크 여유 (박스별)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "node_filesystem_avail_bytes{box=~\".+\", mountpoint=\"/\"}",
          "legendFormat": "{{box}} ({{environment}})"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Swap 사용 (박스별)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "node_memory_SwapTotal_bytes{box=~\".+\"} - node_memory_SwapFree_bytes{box=~\".+\"}",
          "legendFormat": "{{box}} ({{environment}})"
        }
      ]
    }
  ]
}
