          "legendFormat": "renderer"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "DB 커넥션 사용률",
      "description": "MySQL 은 max_connections 대비, core 는 Hikari 풀 대비. 풀이 차면 요청이 커넥션을 기다린다.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "100 * mysql_global_status_threads_connected / mysql_global_variables_max_connections",
          "legendFormat": "MySQL ({{environment}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "100 * max by (environment) (max_over_time(hikaricp_connections_active{application=\"piki-core\"}[$__rate_interval])) / max by (environment) (hikaricp_connections_max{application=\"piki-core\"})",
          "legendFormat": "core 풀 ({{environment}})"
        }
      ]
    },
