{
  "uid": "piki-db",
  "title": "PiKi - db",
  "description": "prod 전용 MySQL 박스 (docker MySQL + mysqld-exporter). 복구 경로는 S3 일 1회 백업뿐이라 백업 관측이 핵심이다.",
  "tags": [
    "piki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "PiKi 대시보드",
      "type": "dashboards",
      "tags": [
        "piki"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": []
  },
